generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String
  interests String?
  createdAt DateTime @default(now())

  games     GamePlayer[]
  media     Media[]
}

model Game {
  id          String   @id @default(cuid())
  name        String
  status      String   @default("LOBBY")
  category    String?
  difficulty  String?

  players     GamePlayer[]
  questions   Question[]

  createdAt   DateTime @default(now())
}

model GamePlayer {
  id      String @id @default(cuid())

  userId  String
  gameId  String

  score   Int @default(0)

  user    User @relation(fields: [userId], references: [id])
  game    Game @relation(fields: [gameId], references: [id])

  @@unique([userId, gameId])
}

model Question {
  id           String @id @default(cuid())

  gameId       String
  question    String
  options      Json
  answer       String
  explanation  String?
  difficulty   String
  category     String

  game         Game @relation(fields: [gameId], references: [id])
}

model Media {
  id          String @id @default(cuid())

  userId      String
  url         String
  type        String

  moderationStatus String
  moderationReason String?

  createdAt   DateTime @default(now())

  user        User @relation(fields: [userId], references: [id])
}